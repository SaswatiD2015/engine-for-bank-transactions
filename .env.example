# Bank Transaction Analytics — Environment Configuration
# Copy this file to .env and update values as needed

# Database (for scaled deployment)
DATABASE_URL=postgresql://analytics:analytics@localhost:5432/bank_analytics

# Redis (optional cache)
REDIS_URL=redis://localhost:6379/0

# Application
APP_ENV=development
LOG_LEVEL=INFO

# Data source (default: sample CSV)
DATA_SOURCE_PATH=data/sample/transactions.csv
